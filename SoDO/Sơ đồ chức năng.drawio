  <diagram name="Trang-1" id="2qiDA5tltMPwGVnBsxf9">
    <mxGraphModel dx="2003" dy="1152" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
